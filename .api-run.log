                   ORDER BY v3.StartPublish DESC LIMIT 1),
                  (SELECT v4.Id FROM NewsContentVersions v4 WHERE v4.RootId = r.Id ORDER BY v4.VersionNumber DESC LIMIT 1)
              ))
          WHERE r.ContentTypeKey = 'NewsContent'
      ) AS "c"
